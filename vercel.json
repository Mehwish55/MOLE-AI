{
  "builds": [
    {
      "src": "vercel_api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["api/**", "mole_ai/**"] }
    },
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api(/.*)?", "dest": "/vercel_api/index.py" },
    { "src": "/", "dest": "/web/index.html" },
    { "src": "/(.*)", "dest": "/web/$1" }
  ]
}
