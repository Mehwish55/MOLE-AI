def get_top_features(
    model,
    feature_names,
    top_n=5,
):
    """
    Return the most important features.

    Parameters
    ----------
    model :
        Trained tree-based model.

    feature_names :
        Feature names.

    top_n :
        Number of features to return.

    Returns
    -------
    pandas.DataFrame
        Top important features.
    """

    importance = get_feature_importance(
        model,
        feature_names,
    )

    return importance.head(top_n)
